{
  "title": "openjts",
  "interval": 60,
  "rules": [
    {
      "uid": "openjts-block-error",
      "title": "OpenJTS BLOCK_ERROR",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "rate(junos_interfaces_eth_in_block_errors_total[5m])",
            "instant": true,
            "range": false,
            "editorMode": "code"
          }
        },
        {
          "refId": "B",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "reduce",
            "expression": "A",
            "reducer": "last",
            "settings": {
              "mode": "dropNN"
            }
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "math",
            "expression": "$B > 1"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "labels": {
        "source": "openjts",
        "probe": "BLOCK_ERROR",
        "severity": "warning"
      },
      "annotations": {
        "summary": "PCS block errors on {{ $labels.if_name }} ({{ $labels.device }})",
        "description": "in_block_errors rate > 1/s. From the monitoring_list probe BLOCK_ERROR in optic/acx_23_optic.json, optic/acx_24_optic.json, optic/acx_optic.json, optic/mx_24_optic.json, optic/mx_optic.json, optic/ptx_23_optic.json, optic/ptx_24_optic.json, optic/ptx_optic.json."
      }
    },
