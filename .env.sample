# Copy to .env (gitignored). Nothing in this file is ever committed.

# Grafana Cloud OTLP: Connections -> OpenTelemetry on your stack. All three
# must come from the same stack. The URL ends in /otlp; Alloy appends /v1/metrics.
GC_OTLP_URL=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GC_OTLP_ACCOUNT=000000
GC_OTLP_KEY=glc_REPLACE_ME

# Router credentials, referenced by name from targets/routers.yaml
# (username_env / password_env). Add more pairs for routers with their own
# login; `make generate` passes every name it finds through to Telegraf.
JUNOS_USERNAME=telemetry
JUNOS_PASSWORD=REPLACE_ME

# Grafana HTTP API, only for `make push-dashboards` / `make push-alerts`.
# Service account token with Editor (dashboards) and alert rule write.
GRAFANA_URL=https://yourstack.grafana.net
GRAFANA_TOKEN=glsa_REPLACE_ME
GRAFANA_FOLDER=OpenJTS
# Prometheus datasource UID the alert rules query (grafanacloud-prom on most stacks)
GRAFANA_PROM_UID=grafanacloud-prom

# Image pins. Leave blank for the defaults in compose.yaml.
TELEGRAF_IMAGE=
ALLOY_IMAGE=
