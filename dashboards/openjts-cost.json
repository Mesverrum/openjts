      "description": "max(active series, total DPM / included DPM) at the 95th percentile. grafanacloud_org_metrics_billable_series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
          },
          "expr": "max(grafanacloud_org_metrics_billable_series)",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
