      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Series from the collector itself",
      "description": "openjts_internal_* from Telegraf. Alloy's own series are job=integrations/self and not counted here.",
      "datasource": {
