        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(group by (device) (junos_device_info{job=\"openjts\"}))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
