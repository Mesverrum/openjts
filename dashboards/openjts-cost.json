            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Included series (org)",
      "description": "grafanacloud_org_metrics_included_series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
