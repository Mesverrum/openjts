          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(otelcol_exporter_sent_metric_points_total{job=\"integrations/self\"}[5m])) * 60 / count({job=\"openjts\"})",
