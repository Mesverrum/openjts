{
  "uid": "openjts-cost",
  "title": "OpenJTS / Cost and cardinality",
  "tags": [
    "openjts",
    "junos",
    "cost"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 2,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**What this costs.** Grafana Cloud bills metrics on whichever is higher, active series or total data points per minute (DPM) divided by the DPM included per series (1 on Pro), at the 95th percentile ([metrics invoice](https://grafana.com/docs/grafana-cloud/cost-management-and-billing/understand-your-invoice/metrics-invoice/)). Halve the sample interval and the same series cost twice as much. Row 1 is the stack as billed (`grafanacloud-usage`), row 2 is where OpenJTS series come from, row 3 is what the collector sends. The collector raises every gNMI sample interval to `min_sample_interval` (60s by default), see `docs/cost.md`."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Stack billing (grafanacloud-usage datasource, whole stack, not only OpenJTS)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active series",
      "description": "Series that received a sample in the last 20 minutes, summed over the selected metrics instances. Source: grafanacloud_instance_active_series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
          },
          "expr": "sum(max by (id) (grafanacloud_instance_active_series{id=~\"$metrics_id\"}))",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DPM per active series (average)",
      "description": "60 x samples per second / active series. Over 1 you are paying for data points, not series. Source: grafanacloud_instance_samples_per_second, grafanacloud_instance_active_series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
          },
          "expr": "60 * sum(max by (id) (grafanacloud_instance_samples_per_second{id=~\"$metrics_id\"})) / sum(max by (id) (grafanacloud_instance_active_series{id=~\"$metrics_id\"}))",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 5,
        "y": 5,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1.05
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Included DPM per series",
      "description": "What the plan includes. grafanacloud_org_metrics_included_dpm_per_series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
          },
          "expr": "max(grafanacloud_org_metrics_included_dpm_per_series)",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 10,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
